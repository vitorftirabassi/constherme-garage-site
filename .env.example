NODE_ENV=production
PORT=3000
DATA_DIR=./data
SESSION_SECRET=troque-este-segredo-por-um-valor-forte
SESSION_SECURE_COOKIE=true
CACHE_TTL_SECONDS=60
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=troque-esta-senha-inicial

# Boom Sistemas
BOOM_API_URL=https://api.boomsistemas.com.br
BOOM_USERNAME=seu-usuario-boom
BOOM_PASSWORD=sua-senha-boom
# Opcional: se a Boom fornecer client_id/client_secret diferentes, configure estes valores.
BOOM_CLIENT_ID=
BOOM_CLIENT_SECRET=
BOOM_CNPJ=00000000000000
