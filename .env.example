NODE_ENV=production
PORT=3000
DATA_DIR=./data
SESSION_SECRET=troque-este-segredo-por-um-valor-forte
SESSION_SECURE_COOKIE=true
CACHE_TTL_SECONDS=60
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=troque-esta-senha-inicial

# Boom Sistemas
# Endpoint oficial do estoque completo da Boom: https://boomsistemas.com.br/api/fullestoque/filial/{CODIGO_FILIAL}/user/{CODIGO_USUARIO}
BOOM_API_URL=https://boomsistemas.com.br
BOOM_USERNAME=seu-usuario-boom
BOOM_PASSWORD=sua-senha-boom
BOOM_FILIAL=0000
BOOM_USUARIO=seu-usuario-boom
# Campos legados mantidos apenas para compatibilidade com integrações antigas.
BOOM_CNPJ=
